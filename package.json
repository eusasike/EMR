{
  "name": "app-service",
  "version": "1.0.0",
  "description": "TypeScript Microservice with Express, Prisma, Redis, RabbitMQ, and tsoa",
  "main": "src/app.ts",
  "scripts": {
    "build:docs": "tsoa spec-and-routes",
    "dev": "tsoa spec-and-routes && ts-node-dev --respawn --transpile-only src/app.ts",
    "worker": "ts-node-dev --respawn src/workers/index.ts",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.18.0",
    "amqplib": "^0.10.4",
    "express": "^4.19.2",
    "ioredis": "^5.4.1",
    "prom-client": "^15.1.3",
    "swagger-ui-express": "^5.0.1",
    "tsoa": "^6.2.1"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.5",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.12",
    "@types/swagger-ui-express": "^4.1.6",
    "prisma": "^5.18.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  }
}
