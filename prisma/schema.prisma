generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum Role {
  ADMIN
  MANAGER
  GUEST
  NURSE
  DOCTOR
  CASHIER
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum PaymentStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  MOBILE_MONEY
  INSURANCE
  CARD
}

enum VisitType {
  OPD
  EMERGENCY
  REFERRAL
  FOLLOW_UP
}

enum VisitPriority {
  NORMAL
  URGENT
  CRITICAL
}

enum InvoiceType {
  FINAL
  INTERIM
}

enum TriagePriority {
  RED
  YELLOW
  GREEN
  BLACK
}

enum AllergySeverity {
  MILD
  MODERATE
  SEVERE
  LIFE_THREATENING
}

enum PrescriptionStatus {
  PENDING
  PARTIALLY_DISPENSED
  COMPLETED
  CANCELLED
}

enum LabStatus {
  ORDERED
  SAMPLE_COLLECTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum InsuranceStatus {
  ACTIVE
  INACTIVE
  EXPIRED
  EXHAUSTED
}

enum ClaimStatus {
  PENDING_PRE_AUTH
  PRE_AUTHORIZED
  SUBMITTED
  APPROVED
  PARTIALLY_APPROVED
  REJECTED
  PAID
  CANCELLED
}

enum WardType {
  GENERAL
  MALE
  FEMALE
  PEDIATRIC
  ICU
  HDUK
  MATERNITY
  SURGICAL
  ISOLATION
  PRIVATE
}

enum BedStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  MAINTENANCE
  CLEANING
}

enum AdmissionStatus {
  ADMITTED
  TRANSFERRED
  DISCHARGED
  CANCELLED
}

// ==========================================
// USER & ACCESS CONTROL
// ==========================================

model User {
  id         String   @id @default(uuid())
  firstName  String   @default("First") @map("first_name")
  lastName   String   @default("Last") @map("last_name")
  middleName String   @default("middle") @map("middle_name")
  email      String   @unique
  phone      String?  @map("phone_number")
  password   String
  role       Role     @default(GUEST)
  isActive   Boolean  @default(true) @map("is_active")

  // EMR Relations
  providedServices ProvidedService[]
  dispenseRecords     DispenseRecord[]
  attendedVisits      PatientVisit[]
  receivedPayments    Payment[]
  vitalSigns          VitalSigns[]
  prescriptions       Prescription[]
  recordedAllergies   PatientAllergy[]
  performedLabResults LabResult[]          @relation("LabPerformedBy")
  verifiedLabResults  LabResult[]          @relation("LabVerifiedBy")
  admittedPatients    AdmissionRecord[]    @relation("AdmittedBy")
  dischargedPatients  AdmissionRecord[]    @relation("DischargedBy")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

// ==========================================
// PATIENT REGISTRY & CLINICAL ENCOUNTERS
// ==========================================

model Patient {
  id                    String   @id @default(uuid())
  mrn                   String   @unique
  firstName             String   @map("first_name")
  lastName              String   @map("last_name")
  middleName            String?
  gender                Gender
  dateOfBirth           DateTime @map("date_of_birth")
  phone                 String?
  emergencyContactName  String?
  emergencyContactPhone String?

  // Relations
  visits            PatientVisit[]
  allergies         PatientAllergy[]
  insurancePolicies PatientInsurance[]
  admissions        AdmissionRecord[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("patients")
}

model PatientVisit {
  id             String          @id @default(uuid())
  patientId      String          @map("patient_id")
  patient        Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  attendingId    String          @map("attending_id")
  attending      User            @relation(fields: [attendingId], references: [id])
  diagnosis      String?
  icdCode        String?         @map("icd_code")
  symptoms       String?
  visitType      VisitType       @default(OPD) @map("visit_type")
  priority       VisitPriority   @default(NORMAL)
  triagePriority TriagePriority?

  // Relations
  services       ProvidedService[]
  dispenseRecord DispenseRecord?
  invoice        Invoice?
  vitalSigns     VitalSigns?
  claims         InsuranceClaim[]
  prescriptions  Prescription[]
  labResults     LabResult[]
  admission      AdmissionRecord?

  createdAt DateTime @default(now()) @map("created_at")

  @@map("patient_visits")
}

model VitalSigns {
  id              String         @id @default(uuid())
  visitId         String         @unique @map("visit_id")
  visit           PatientVisit   @relation(fields: [visitId], references: [id], onDelete: Cascade)
  temperature     Decimal        @db.Decimal(4, 1)
  systolicBP      Int            @map("systolic_bp")
  diastolicBP     Int            @map("diastolic_bp")
  pulseRate       Int            @map("pulse_rate")
  respiratoryRate Int            @map("respiratory_rate")
  spo2            Int
  weight          Decimal        @db.Decimal(5, 2)
  height          Decimal        @db.Decimal(5, 2)
  bmi             Decimal?       @db.Decimal(4, 1)
  priority        TriagePriority @default(GREEN)
  notes           String?
  recordedById    String         @map("recorded_by_id")
  recordedBy      User           @relation(fields: [recordedById], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("vital_signs")
}

// ==========================================
// MEDICAL SERVICES CATALOG
// ==========================================

model MedicalService {
  id       String  @id @default(uuid())
  name     String  @unique
  category String
  price    Decimal @db.Decimal(10, 2)

  // Relations
  providedServices ProvidedService[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("medical_services")
}

model ProvidedService {
  id           String         @id @default(uuid())
  visitId      String         @map("visit_id")
  visit        PatientVisit   @relation(fields: [visitId], references: [id], onDelete: Cascade)
  serviceId    String         @map("service_id")
  service      MedicalService @relation(fields: [serviceId], references: [id])
  providedById String         @map("provided_by_id")
  providedBy   User           @relation(fields: [providedById], references: [id])
  unitPrice    Decimal        @map("unit_price") @db.Decimal(10, 2)
  notes        String?
  labResult    LabResult?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("provided_services")
}

// ==========================================
// PHARMACY & INVENTORY (MULTI-BATCH SUPPORT)
// ==========================================

model Product {
  id           String  @id @default(uuid())
  code         String? @unique
  name         String  @unique
  description  String?
  category     String  @default("MEDICINE")
  unitPrice    Decimal @map("unit_price") @db.Decimal(10, 2)
  reorderLevel Int     @default(10) @map("reorder_level")

  // Relations
  batches           ProductBatch[]
  dispensedItems    DispensedItem[]
  prescriptionItems PrescriptionItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("products")
}

model ProductBatch {
  id          String   @id @default(uuid())
  productId   String   @map("product_id")
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  batchNumber String   @map("batch_number")
  quantity    Int      @default(0)
  initialQty  Int      @map("initial_qty")
  costPrice   Decimal? @map("cost_price") @db.Decimal(10, 2)
  expiryDate  DateTime @map("expiry_date")

  // Relations
  dispensedItems DispensedItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([productId, batchNumber])
  @@map("product_batches")
}

model DispenseRecord {
  id            String        @id @default(uuid())
  visitId       String?       @unique @map("visit_id")
  visit         PatientVisit? @relation(fields: [visitId], references: [id], onDelete: SetNull)
  dispensedById String        @map("dispensed_by_id")
  dispensedBy   User          @relation(fields: [dispensedById], references: [id])
  totalCost     Decimal       @map("total_cost") @db.Decimal(10, 2)
  notes         String?

  // Relations
  items          DispensedItem[]
  prescriptionId String?         @map("prescription_id")
  prescription   Prescription?   @relation(fields: [prescriptionId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@map("dispense_records")
}

model DispensedItem {
  id               String         @id @default(uuid())
  dispenseRecordId String         @map("dispense_record_id")
  dispenseRecord   DispenseRecord @relation(fields: [dispenseRecordId], references: [id], onDelete: Cascade)
  productId        String         @map("product_id")
  product          Product        @relation(fields: [productId], references: [id])
  batchId          String         @map("batch_id")
  batch            ProductBatch   @relation(fields: [batchId], references: [id])
  quantity         Int
  unitPrice        Decimal        @map("unit_price") @db.Decimal(10, 2)

  @@map("dispensed_items")
}

// ==========================================
// BILLING & PAYMENTS
// ==========================================

model Invoice {
  id            String       @id @default(uuid())
  invoiceNumber String       @unique @map("invoice_number")
  visitId       String       @unique @map("visit_id")
  visit         PatientVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  serviceTotal    Decimal       @default(0) @map("service_total") @db.Decimal(10, 2)
  medicationTotal Decimal       @default(0) @map("medication_total") @db.Decimal(10, 2)
  grandTotal      Decimal       @map("grand_total") @db.Decimal(10, 2)
  amountPaid      Decimal       @default(0) @map("amount_paid") @db.Decimal(10, 2)
  balance         Decimal       @default(0) @db.Decimal(10, 2)
  status          PaymentStatus @default(PENDING)
  type            InvoiceType   @default(FINAL)

  // Relations
  insuranceClaim InsuranceClaim?
  payments       Payment[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("invoices")
}

model Payment {
  id            String        @id @default(uuid())
  invoiceId     String        @map("invoice_id")
  invoice       Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount        Decimal       @db.Decimal(10, 2)
  paymentMethod PaymentMethod @map("payment_method")
  referenceNo   String?       @map("reference_no")
  receivedById  String        @map("received_by_id")
  receivedBy    User          @relation(fields: [receivedById], references: [id])
  notes         String?

  createdAt DateTime @default(now()) @map("created_at")

  @@map("payments")
}

// ==========================================
// ALLERGIES, PRESCRIPTIONS & LABS
// ==========================================

model PatientAllergy {
  id           String          @id @default(uuid())
  patientId    String          @map("patient_id")
  patient      Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  allergen     String
  category     String?
  reaction     String?
  severity     AllergySeverity @default(MODERATE)
  recordedById String?         @map("recorded_by_id")
  recordedBy   User?           @relation(fields: [recordedById], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("patient_allergies")
}

model Prescription {
  id                 String             @id @default(uuid())
  prescriptionNumber String             @unique @map("prescription_number")
  visitId            String             @map("visit_id")
  visit              PatientVisit       @relation(fields: [visitId], references: [id], onDelete: Cascade)
  prescribedById     String             @map("prescribed_by_id")
  prescribedBy       User               @relation(fields: [prescribedById], references: [id])
  status             PrescriptionStatus @default(PENDING)
  notes              String?

  items           PrescriptionItem[]
  dispenseRecords DispenseRecord[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("prescriptions")
}

model PrescriptionItem {
  id                String       @id @default(uuid())
  prescriptionId    String       @map("prescription_id")
  prescription      Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  productId         String       @map("product_id")
  product           Product      @relation(fields: [productId], references: [id])
  dosage            String
  frequency         String
  durationDays      Int          @map("duration_days")
  quantityOrdered   Int          @map("quantity_ordered")
  quantityDispensed Int          @default(0) @map("quantity_dispensed")
  route             String?
  instructions      String?

  @@map("prescription_items")
}

model LabResult {
  id                String          @id @default(uuid())
  providedServiceId String          @unique @map("provided_service_id")
  providedService   ProvidedService @relation(fields: [providedServiceId], references: [id], onDelete: Cascade)
  visitId           String          @map("visit_id")
  visit             PatientVisit    @relation(fields: [visitId], references: [id], onDelete: Cascade)
  specimenType      String?         @map("specimen_type")
  resultValue       String?         @map("result_value")
  unit              String?
  referenceRange    String?         @map("reference_range")
  status            LabStatus       @default(ORDERED)
  findings          String?
  performedById     String?         @map("performed_by_id")
  performedBy       User?           @relation("LabPerformedBy", fields: [performedById], references: [id])
  verifiedById      String?         @map("verified_by_id")
  verifiedBy        User?           @relation("LabVerifiedBy", fields: [verifiedById], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("lab_results")
}

// ==========================================
// INSURANCE & CLAIMS
// ==========================================

model PatientInsurance {
  id            String          @id @default(uuid())
  patientId     String          @map("patient_id")
  patient       Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  providerName  String          @map("provider_name")
  policyNumber  String          @map("policy_number")
  cardNumber    String          @map("card_number")
  principalName String?         @map("principal_name")
  relationship  String?         @default("SELF")
  coverageLimit Decimal?        @map("coverage_limit") @db.Decimal(10, 2)
  status        InsuranceStatus @default(ACTIVE)
  expiryDate    DateTime?       @map("expiry_date")

  // Relations
  claims InsuranceClaim[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([providerName, cardNumber])
  @@map("patient_insurance")
}

model InsuranceClaim {
  id                 String           @id @default(uuid())
  claimNumber        String           @unique @map("claim_number")
  visitId            String           @map("visit_id")
  visit              PatientVisit     @relation(fields: [visitId], references: [id], onDelete: Cascade)
  invoiceId          String?          @unique @map("invoice_id")
  invoice            Invoice?         @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  patientInsuranceId String           @map("patient_insurance_id")
  patientInsurance   PatientInsurance @relation(fields: [patientInsuranceId], references: [id])

  preAuthCode     String?     @map("pre_auth_code")
  requestedAmount Decimal     @map("requested_amount") @db.Decimal(10, 2)
  approvedAmount  Decimal     @default(0) @map("approved_amount") @db.Decimal(10, 2)
  coPayAmount     Decimal     @default(0) @map("co_pay_amount") @db.Decimal(10, 2)
  status          ClaimStatus @default(PENDING_PRE_AUTH)

  rejectionReason String? @map("rejection_reason")
  notes           String?

  submittedAt DateTime? @map("submitted_at")
  processedAt DateTime? @map("processed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("insurance_claims")
}

// ==========================================
// WARD & ADMISSIONS
// ==========================================

model Ward {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String?  @unique
  type        WardType @default(GENERAL)
  capacity    Int      @default(10)
  dailyRate   Decimal  @map("daily_rate") @db.Decimal(10, 2)
  description String?

  // Relations
  beds Bed[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("wards")
}

model Bed {
  id        String    @id @default(uuid())
  wardId    String    @map("ward_id")
  ward      Ward      @relation(fields: [wardId], references: [id], onDelete: Cascade)
  bedNumber String    @map("bed_number")
  status    BedStatus @default(AVAILABLE)

  // Relations
  admissions AdmissionRecord[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([wardId, bedNumber])
  @@map("beds")
}

model AdmissionRecord {
  id              String          @id @default(uuid())
  admissionNumber String          @unique @map("admission_number")
  visitId         String          @unique @map("visit_id")
  visit           PatientVisit    @relation(fields: [visitId], references: [id], onDelete: Cascade)
  patientId       String          @map("patient_id")
  patient         Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  bedId           String          @map("bed_id")
  bed             Bed             @relation(fields: [bedId], references: [id])
  admittedById    String          @map("admitted_by_id")
  admittedBy      User            @relation("AdmittedBy", fields: [admittedById], references: [id])
  dischargedById  String?         @map("discharged_by_id")
  dischargedBy    User?           @relation("DischargedBy", fields: [dischargedById], references: [id])

  admittedAt     DateTime        @default(now()) @map("admitted_at")
  dischargedAt   DateTime?       @map("discharged_at")
  status         AdmissionStatus @default(ADMITTED)
  admissionNotes String?         @map("admission_notes")
  dischargeNotes String?         @map("discharge_notes")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("admission_records")
}