{
	"openapi": "3.0.0",
	"components": {
		"examples": {},
		"headers": {},
		"parameters": {},
		"requestBodies": {},
		"responses": {},
		"schemas": {
			"User": {
				"properties": {
					"id": {
						"type": "string"
					},
					"email": {
						"type": "string"
					},
					"name": {
						"type": "string"
					},
					"role": {
						"type": "string",
						"enum": [
							"admin",
							"user",
							"manager"
						]
					},
					"createdAt": {
						"type": "string",
						"format": "date-time"
					}
				},
				"required": [
					"id",
					"email",
					"name",
					"role",
					"createdAt"
				],
				"type": "object",
				"additionalProperties": false
			},
			"PaginatedUsersResponse": {
				"properties": {
					"data": {
						"items": {
							"$ref": "#/components/schemas/User"
						},
						"type": "array"
					},
					"total": {
						"type": "number",
						"format": "double"
					},
					"page": {
						"type": "number",
						"format": "double"
					},
					"limit": {
						"type": "number",
						"format": "double"
					}
				},
				"required": [
					"data",
					"total",
					"page",
					"limit"
				],
				"type": "object",
				"additionalProperties": false
			},
			"Record_string.unknown_": {
				"properties": {},
				"additionalProperties": {},
				"type": "object",
				"description": "Construct a type with a set of properties K of type T"
			},
			"ErrorResponse": {
				"properties": {
					"message": {
						"type": "string"
					},
					"code": {
						"type": "string"
					},
					"details": {
						"$ref": "#/components/schemas/Record_string.unknown_"
					}
				},
				"required": [
					"message",
					"code"
				],
				"type": "object",
				"additionalProperties": false
			},
			"UserCreationParams": {
				"properties": {
					"email": {
						"type": "string"
					},
					"name": {
						"type": "string"
					},
					"role": {
						"type": "string",
						"enum": [
							"admin",
							"user",
							"manager"
						]
					}
				},
				"required": [
					"email",
					"name"
				],
				"type": "object",
				"additionalProperties": false
			},
			"UserUpdateParams": {
				"properties": {
					"name": {
						"type": "string"
					},
					"role": {
						"type": "string",
						"enum": [
							"admin",
							"user",
							"manager"
						]
					}
				},
				"type": "object",
				"additionalProperties": false
			},
			"HealthResponse": {
				"properties": {
					"status": {
						"type": "string",
						"enum": [
							"ok",
							"error"
						]
					},
					"timestamp": {
						"type": "string"
					},
					"dependencies": {
						"properties": {
							"rabbitmq": {
								"type": "boolean"
							},
							"redis": {
								"type": "boolean"
							},
							"database": {
								"type": "boolean"
							}
						},
						"required": [
							"rabbitmq",
							"redis",
							"database"
						],
						"type": "object"
					}
				},
				"required": [
