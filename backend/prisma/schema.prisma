generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Region {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  districts  District[]
  facilities Facility[]
  patients   Patient[]

  @@map("regions")
}

model District {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  regionId  String   @map("region_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  region     Region     @relation(fields: [regionId], references: [id], onDelete: Cascade)
  facilities Facility[]
  patients   Patient[]

  @@unique([regionId, name])
  @@map("districts")
}

model Facility {
  id         String    @id @default(uuid())
  code       String    @unique
  name       String
  isActive  Boolean  @default(true) @map("is_active") // 👈 Maps DB column to camelCase TS property 
  location   String?
  regionId   String?   @map("region_id")
  districtId String?   @map("district_id")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  region   Region?   @relation(fields: [regionId], references: [id], onDelete: SetNull)
  district District? @relation(fields: [districtId], references: [id], onDelete: SetNull)

  users            FacilityUser[]
  patients         Patient[]
  patientVisits    PatientVisit[]
  products         Product[]
  dispenseRecords  DispenseRecord[]
  invoices         Invoice[]
  patientAllergies PatientAllergy[]
  prescriptions    Prescription[]
  patientInsurance PatientInsurance[]
  insuranceClaims  InsuranceClaim[]
  wards            Ward[]
  admissionRecords AdmissionRecord[]
  medicalServices  MedicalService[]

  @@map("facilities")
}

model FacilityUser {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  facilityId String   @map("facility_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@unique([userId, facilityId])
  @@map("facility_users")
}

model User {
  id                 String            @id @default(uuid())
  email              String            @unique
  password           String
  role               Role              @default(GUEST)
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  firstName          String            @default("First") @map("first_name")
  lastName           String            @default("Last") @map("last_name")
  middleName         String            @default("middle") @map("middle_name")
  isActive           Boolean           @default(true) @map("is_active")
  phone              String?           @map("phone_number")

  facilities         FacilityUser[]
  admittedPatients   AdmissionRecord[] @relation("AdmittedBy")
  dischargedPatients AdmissionRecord[] @relation("DischargedBy")
  dispenseRecords    DispenseRecord[]
  performedLabResults LabResult[]       @relation("LabPerformedBy")
  verifiedLabResults  LabResult[]       @relation("LabVerifiedBy")
  recordedAllergies  PatientAllergy[]
  attendedVisits     PatientVisit[]
  receivedPayments   Payment[]
  prescriptions      Prescription[]
  providedServices   ProvidedService[]
  vitalSigns         VitalSigns[]

  @@map("users")
}

model Patient {
  id                    String             @id @default(uuid())
  mrn                   String             @map("mrn")
  facilityId            String             @map("facility_id")
  facility              Facility           @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  firstName             String             @map("first_name")
  lastName              String             @map("last_name")
  middleName            String?
  gender                Gender
  dateOfBirth           DateTime           @map("date_of_birth")
  phone                 String?
  address               String?
  regionId              String?            @map("region_id")
  districtId            String?            @map("district_id")
  emergencyContactName  String?
  emergencyContactPhone String?
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")

  region                Region?            @relation(fields: [regionId], references: [id], onDelete: SetNull)
  district              District?          @relation(fields: [districtId], references: [id], onDelete: SetNull)
  admissions            AdmissionRecord[]
  allergies             PatientAllergy[]
  insurancePolicies     PatientInsurance[]
  visits                PatientVisit[]

  @@unique([facilityId, mrn])
  @@map("patients")
}

model PatientVisit {
  id             String           @id @default(uuid())
  facilityId     String           @map("facility_id")
  patientId      String           @map("patient_id")
  attendingId    String           @map("attending_id")
  diagnosis      String?
  icdCode        String?          @map("icd_code")
  symptoms       String?
  priority       VisitPriority    @default(NORMAL)
  visitType      VisitType        @default(OPD) @map("visit_type")
  triagePriority TriagePriority?
  createdAt      DateTime         @default(now()) @map("created_at")
  status      VisitStatus         @default(NOT_STARTED)
  
  facility       Facility         @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  attending      User             @relation(fields: [attendingId], references: [id])
  patient        Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  admission      AdmissionRecord?
  dispenseRecord DispenseRecord?
  claims         InsuranceClaim[]
  invoice        Invoice?
  labResults     LabResult[]
  prescriptions  Prescription[]
  services       ProvidedService[]
  vitalSigns     VitalSigns?

  @@index([facilityId])
  @@map("patient_visits")
}

model VitalSigns {
  id              String         @id @default(uuid())
  visitId         String         @unique @map("visit_id")
  temperature     Decimal?       @db.Decimal(4, 1)
  systolicBP      Int?           @map("systolic_bp")
  diastolicBP     Int?            @map("diastolic_bp")
  pulseRate       Int?           @map("pulse_rate")
  respiratoryRate Int?            @map("respiratory_rate")
  spo2            Int?
  weight          Decimal        @db.Decimal(5, 2)
  height          Decimal?        @db.Decimal(5, 2)
  bmi             Decimal?       @db.Decimal(4, 1)
  priority        TriagePriority @default(GREEN)
  notes           String?
  recordedById    String         @map("recorded_by_id")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  recordedBy      User           @relation(fields: [recordedById], references: [id])
  visit           PatientVisit   @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@map("vital_signs")
}

model MedicalService {
  id               String            @id @default(uuid())
  facilityId       String            @map("facility_id")
  name             String
  category         String
  price            Decimal           @db.Decimal(10, 2)
  isActive         Boolean           @default(true) @map("is_active")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  facility         Facility          @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  providedServices ProvidedService[]

  @@unique([facilityId, name])
  @@map("medical_services")
}
model ProvidedService {
  id           String         @id @default(uuid())
  visitId      String         @map("visit_id")
  serviceId    String         @map("service_id")
  unitPrice    Decimal        @map("unit_price") @db.Decimal(10, 2)
  notes        String?
  providedById String         @map("provided_by_id")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  labResult    LabResult?
  providedBy   User           @relation(fields: [providedById], references: [id])
  service      MedicalService @relation(fields: [serviceId], references: [id])
  visit        PatientVisit   @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@map("provided_services")
}

model Product {
  id                String             @id @default(uuid())
  facilityId        String             @map("facility_id")
  name              String
  description       String?
  unitPrice         Decimal            @map("unit_price") @db.Decimal(10, 2)
  category          String             @default("MEDICINE")
  code              String?
  reorderLevel      Int                @default(10) @map("reorder_level")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  facility          Facility           @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  dispensedItems    DispensedItem[]
  prescriptionItems PrescriptionItem[]
  batches           ProductBatch[]

  @@unique([facilityId, name])
  @@unique([facilityId, code])
  @@map("products")
}

model ProductBatch {
  id             String          @id @default(uuid())
  productId      String          @map("product_id")
  batchNumber    String          @map("batch_number")
  quantity       Int             @default(0)
  initialQty     Int             @map("initial_qty")
  costPrice      Decimal?        @map("cost_price") @db.Decimal(10, 2)
  expiryDate     DateTime        @map("expiry_date")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  dispensedItems DispensedItem[]
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, batchNumber])
  @@map("product_batches")
}

model DispensedItem {
  id            String       @id @default(uuid())
  dispenseId    String       @map("dispense_id")
  productId     String       @map("product_id")
  batchId       String?      @map("batch_id")
  quantity      Int
  unitPrice     Decimal      @map("unit_price") @db.Decimal(10, 2)
  totalPrice    Decimal      @map("total_price") @db.Decimal(10, 2)
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  dispenseRecord DispenseRecord @relation(fields: [dispenseId], references: [id], onDelete: Cascade)
  product        Product        @relation(fields: [productId], references: [id])
  batch          ProductBatch?  @relation(fields: [batchId], references: [id])

  @@map("dispensed_items")
}

model DispenseRecord {
  id             String         @id @default(uuid())
  facilityId     String         @map("facility_id")
  visitId        String?        @unique @map("visit_id")
  prescriptionId String?        @unique @map("prescription_id")
  dispensedById  String         @map("dispensed_by_id")
  totalCost      Decimal        @default(0) @map("total_cost") @db.Decimal(10, 2)
  notes          String?
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  facility       Facility       @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  visit          PatientVisit?  @relation(fields: [visitId], references: [id], onDelete: Cascade)
  prescription   Prescription?  @relation(fields: [prescriptionId], references: [id])
  dispensedBy    User           @relation(fields: [dispensedById], references: [id])
  items          DispensedItem[]

  @@map("dispense_records")
}

model Invoice {
  id             String          @id @default(uuid())
  facilityId     String          @map("facility_id")
  visitId        String?         @unique @map("visit_id")
  invoiceNumber  String          @map("invoice_number")
  totalAmount    Decimal         @map("total_amount") @db.Decimal(10, 2)
  paidAmount     Decimal         @default(0) @map("paid_amount") @db.Decimal(10, 2)
  status         InvoiceStatus   @default(PENDING)
  type           InvoiceType     @default(FINAL)
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  facility       Facility        @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  visit          PatientVisit?   @relation(fields: [visitId], references: [id], onDelete: Cascade)
  payments       Payment[]
  insuranceClaim InsuranceClaim?

  @@unique([facilityId, invoiceNumber])
  @@map("invoices")
}

model Payment {
  id            String        @id @default(uuid())
  invoiceId     String        @map("invoice_id")
  amount        Decimal       @db.Decimal(10, 2)
  paymentMethod PaymentMethod @map("payment_method")
  referenceNo   String?       @map("reference_no")
  receivedById  String        @map("received_by_id")
  notes         String?
  createdAt     DateTime      @default(now()) @map("created_at")

  invoice       Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  receivedBy    User          @relation(fields: [receivedById], references: [id])

  @@map("payments")
}

model PatientAllergy {
  id           String          @id @default(uuid())
  facilityId   String          @map("facility_id")
  patientId    String          @map("patient_id")
  allergen     String
  category     String?
  reaction     String?
  severity     AllergySeverity @default(MODERATE)
  recordedById String?         @map("recorded_by_id")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  facility     Facility        @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  patient      Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  recordedBy   User?           @relation(fields: [recordedById], references: [id])

  @@index([facilityId])
  @@map("patient_allergies")
}

model Prescription {
  id                 String             @id @default(uuid())
  facilityId         String             @map("facility_id")
  prescriptionNumber String             @map("prescription_number")
  visitId            String             @map("visit_id")
  prescribedById     String             @map("prescribed_by_id")
  status             PrescriptionStatus @default(PENDING)
  notes              String?
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  facility           Facility           @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  dispenseRecords    DispenseRecord[]
  items              PrescriptionItem[]
  prescribedBy       User               @relation(fields: [prescribedById], references: [id])
  visit              PatientVisit       @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@unique([facilityId, prescriptionNumber])
  @@map("prescriptions")
}

model PrescriptionItem {
  id             String       @id @default(uuid())
  prescriptionId String       @map("prescription_id")
  productId      String       @map("product_id")
  quantityOrdered Int         @map("quantity_ordered")
  unitPrice      Decimal      @map("unit_price") @db.Decimal(10, 2)
  dosage         String?
  frequency      String?
  durationDays   Int?         @map("duration_days")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  product        Product      @relation(fields: [productId], references: [id])

  @@map("prescription_items")
}



model LabResult {
  id                String          @id @default(uuid())
  providedServiceId String          @unique @map("provided_service_id")
  visitId           String          @map("visit_id")
  specimenType      String?         @map("specimen_type")
  resultValue       String?         @map("result_value")
  unit              String?
  referenceRange    String?         @map("reference_range")
  status            LabStatus       @default(ORDERED)
  findings          String?
  performedById     String?         @map("performed_by_id")
  verifiedById      String?         @map("verified_by_id")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  performedBy       User?           @relation("LabPerformedBy", fields: [performedById], references: [id])
  providedService   ProvidedService @relation(fields: [providedServiceId], references: [id], onDelete: Cascade)
  verifiedBy        User?           @relation("LabVerifiedBy", fields: [verifiedById], references: [id])
  visit             PatientVisit    @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@map("lab_results")
}

model PatientInsurance {
  id            String           @id @default(uuid())
  facilityId    String           @map("facility_id")
  patientId     String           @map("patient_id")
  providerName  String           @map("provider_name")
  policyNumber  String           @map("policy_number")
  cardNumber    String           @map("card_number")
  principalName String?          @map("principal_name")
  relationship  String?          @default("SELF")
  coverageLimit Decimal?         @map("coverage_limit") @db.Decimal(10, 2)
  status        InsuranceStatus  @default(ACTIVE)
  expiryDate    DateTime?        @map("expiry_date")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  facility      Facility         @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  claims        InsuranceClaim[]
  patient       Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([facilityId, providerName, cardNumber])
  @@map("patient_insurance")
}

model InsuranceClaim {
  id                 String           @id @default(uuid())
  facilityId         String           @map("facility_id")
  claimNumber        String           @map("claim_number")
  visitId            String           @map("visit_id")
  invoiceId          String?          @unique @map("invoice_id")
  patientInsuranceId String           @map("patient_insurance_id")
  preAuthCode        String?          @map("pre_auth_code")
  requestedAmount    Decimal          @map("requested_amount") @db.Decimal(10, 2)
  approvedAmount     Decimal          @default(0) @map("approved_amount") @db.Decimal(10, 2)
  coPayAmount        Decimal          @default(0) @map("co_pay_amount") @db.Decimal(10, 2)
  status             ClaimStatus      @default(PENDING_PRE_AUTH)
  rejectionReason    String?          @map("rejection_reason")
  notes              String?
  submittedAt        DateTime?        @map("submitted_at")
  processedAt        DateTime?        @map("processed_at")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  facility           Facility         @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  invoice            Invoice?         @relation(fields: [invoiceId], references: [id])
  patientInsurance   PatientInsurance @relation(fields: [patientInsuranceId], references: [id])
  visit              PatientVisit     @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@unique([facilityId, claimNumber])
  @@map("insurance_claims")
}

model Ward {
  id          String   @id @default(uuid())
  facilityId  String   @map("facility_id")
  name        String
  code        String?
  type        WardType @default(GENERAL)
  capacity    Int      @default(10)
  dailyRate   Decimal  @map("daily_rate") @db.Decimal(10, 2)
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  facility    Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  beds        Bed[]

  @@unique([facilityId, name])
  @@unique([facilityId, code])
  @@map("wards")
}

model Bed {
  id         String            @id @default(uuid())
  wardId     String            @map("ward_id")
  bedNumber  String            @map("bed_number")
  status     BedStatus         @default(AVAILABLE)
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")

  admissions AdmissionRecord[]
  ward       Ward              @relation(fields: [wardId], references: [id], onDelete: Cascade)

  @@unique([wardId, bedNumber])
  @@map("beds")
}

model AdmissionRecord {
  id              String          @id @default(uuid())
  facilityId      String          @map("facility_id")
  admissionNumber String          @map("admission_number")
  visitId         String          @unique @map("visit_id")
  patientId       String          @map("patient_id")
  bedId           String          @map("bed_id")
  admittedById    String          @map("admitted_by_id")
  dischargedById  String?         @map("discharged_by_id")
  admittedAt      DateTime        @default(now()) @map("admitted_at")
  dischargedAt    DateTime?       @map("discharged_at")
  status          AdmissionStatus @default(ADMITTED)
  admissionNotes  String?         @map("admission_notes")
  dischargeNotes  String?         @map("discharge_notes")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  facility        Facility        @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  admittedBy      User            @relation("AdmittedBy", fields: [admittedById], references: [id])
  bed             Bed             @relation(fields: [bedId], references: [id])
  dischargedBy    User?           @relation("DischargedBy", fields: [dischargedById], references: [id])
  patient         Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  visit           PatientVisit    @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@unique([facilityId, admissionNumber])
  @@map("admission_records")
}

enum Role {
  ADMIN
  MANAGER
  GUEST
  NURSE
  DOCTOR
  CASHIER
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum PaymentStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  MOBILE_MONEY
  INSURANCE
  CARD
}

enum VisitType {
  OPD
  EMERGENCY
  REFERRAL
  FOLLOW_UP
  IPD
}

enum VisitPriority {
  NORMAL
  URGENT
  CRITICAL
}

enum InvoiceType {
  FINAL
  INTERIM
}

enum TriagePriority {
  RED
  YELLOW
  GREEN
  BLACK
}

enum AllergySeverity {
  MILD
  MODERATE
  SEVERE
  LIFE_THREATENING
}

enum PrescriptionStatus {
  PENDING
  PARTIALLY_DISPENSED
  COMPLETED
  CANCELLED
}

enum LabStatus {
  ORDERED
  SAMPLE_COLLECTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  VERIFIED
}

enum InsuranceStatus {
  ACTIVE
  INACTIVE
  EXPIRED
  EXHAUSTED
}

enum ClaimStatus {
  PENDING_PRE_AUTH
  PRE_AUTHORIZED
  SUBMITTED
  APPROVED
  PARTIALLY_APPROVED
  REJECTED
  PAID
  CANCELLED
}

enum WardType {
  GENERAL
  MALE
  FEMALE
  PEDIATRIC
  ICU
  HDUK
  MATERNITY
  SURGICAL
  ISOLATION
  PRIVATE
}

enum BedStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  MAINTENANCE
  CLEANING
}

enum AdmissionStatus {
  ADMITTED
  TRANSFERRED
  DISCHARGED
  CANCELLED
}

enum ChargeType {
  CONSULTATION
  LABORATORY
  PHARMACY
  PROCEDURE
}

enum InvoiceStatus {
  PENDING
  PAID
  CANCELLED
}

enum VisitStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}