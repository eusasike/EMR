{
  "name": "auth-service",
  "version": "1.0.0",
  "description": "Authentication and RBAC Microservice",
  "main": "dist/src/server.js",
  "scripts": {
    "prebuild": "npm run swagger",
    "db:seed": "prisma db seed",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "swagger": "tsoa spec-and-routes",
    "dev": "concurrently \"tsoa spec-and-routes --w\" \"tsx watch src/server.ts\""
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "amqplib": "^0.10.4",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-prom-bundle": "^8.0.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "pg": "^8.12.0",
    "pino": "^9.3.2",
    "pino-http": "^10.2.0",
    "prom-client": "^15.1.3",
    "swagger-ui-express": "^5.0.1",
    "tsoa": "^6.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.5",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.5.0",
    "@types/pg": "^8.11.8",
    "@types/swagger-ui-express": "^4.1.6",
    "concurrently": "^8.2.2",
    "cookie-parser": "^1.4.7",
    "prisma": "^6.19.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.5.4"
  }
}
