{
  "entryFile": "src/app.ts",
  "noImplicitAdditionalProperties": "throw-on-extras",
  "controllerPathGlobs": ["src/controllers/**/*.controller.ts"],
  "routes": {
    "routesDir": "src/generated",
    "middleware": "express",
    "authenticationModule": "src/middlewares/authenticate",
    "iocModule": ""
  },
  "spec": {
    "outputDirectory": "src/generated",
    "specVersion": 3,
    "info": {
      "title": "Auth Microservice API",
      "version": "1.0.0",
      "description": "Authentication and RBAC microservice using Express and TSOA"
    },
    "securityDefinitions": {
      "jwt": {
        "type": "apiKey",
        "name": "Authorization",
        "in": "header"
      }
    }
  }
}
