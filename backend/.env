# Server Configuration
PORT=4000
NODE_ENV=development
JWT_SECRET='your-default-super-secret-key'
JWT_REFRESH_SECRET='your-default-b -secret-key'
JWT_EXPIRES_IN=1h
BCRYPT_SALT_ROUNDS=10

# Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# 1. Connection Pooler URL (Used by your active Node.js server app)
DATABASE_URL=postgres://neondb_owner:npg_jiKp4q1gLCeo@ep-steep-brook-aykt8d5i-pooler.c-5.us-east-2.aws.neon.tech/neondb?channel_binding=require&sslmode=require

# Cache (Redis)
REDIS_URL="redis://localhost:6379"

# Message Broker (RabbitMQ)
RABBITMQ_URL="amqp://guest:guest@localhost:5672"

# Logging Configuration
LOG_LEVEL=info

ADMIN_EMAIL="admin@system.local"
ADMIN_PASSWORD="Admin@123456!"
# 2. Raw Unpooled URL (Auto-generated fallback)
DATABASE_URL_UNPOOLED=postgres://neondb_owner:npg_jiKp4q1gLCeo@ep-steep-brook-aykt8d5i.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require

NEON_BRANCH=production

# 3. Direct URL (Used exclusively by Prisma Migrate to build your tables)
DIRECT_URL=postgres://neondb_owner:npg_jiKp4q1gLCeo@ep-steep-brook-aykt8d5i.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require
